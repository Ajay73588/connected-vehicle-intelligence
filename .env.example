# Copy to .env — `cp .env.example .env`. NEVER commit .env.  All values below are DEVELOPMENT defaults for synthetic data.
# In production these come from a secret manager (AWS Secrets Manager / External Secrets in Kubernetes), not a file.

# ---- compose profile: "sim" starts the simulator automatically (unset it to run without synthetic traffic)
COMPOSE_PROFILES=sim

# ---- secrets (change for anything but a laptop demo)
POSTGRES_PASSWORD=cvi-dev-password
APP_DB_PASSWORD=cvi-app-dev-password
WORKER_DB_PASSWORD=cvi-worker-dev-password
JWT_SECRET=change-me-dev-only-0123456789abcdef0123456789abcdef
INGEST_API_KEY=dev-device-key-change-me
MINIO_ROOT_USER=cvi-minio
MINIO_ROOT_PASSWORD=cvi-minio-dev-password
GRAFANA_ADMIN_PASSWORD=admin
DEMO_PASSWORD=Demo@12345

# ---- dataset (the hackathon target is 100000; use 5000 for a 30-second first start)
SEED_VEHICLES=100000
SEED_HISTORY_ALERTS=200000
SEED_HISTORY_DAYS=14

# ---- simulator (mode: demo | small | load | 100k, or set explicit numbers)
SIM_MODE=demo
SIM_VEHICLES=1000
SIM_EVENTS_PER_SECOND=150

# ---- pipeline tuning
WORKER_BATCH_SIZE=500
ALLOWED_LATENESS_S=300
RATE_LIMIT_PER_MINUTE=600
TOPIC_PARTITIONS=12
RAW_EVENTS_TTL_DAYS=7

# ---- optional: LLM narration for the AI copilot (the agent works fully without it)
ANTHROPIC_API_KEY=

# ---- host ports
FRONTEND_PORT=8080
API_PORT=8000
INGEST_PORT=8001
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
JAEGER_PORT=16686
MINIO_CONSOLE_PORT=9001
