{
  "uid": "cvi-overview",
  "title": "CVI \u2014 Pipeline & API overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "tags": [
    "cvi"
  ],
  "panels": [
    {
      "id": 1,
      "title": "Ingestion rate (events/s)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(events_received_total[1m]))",
          "legendFormat": "received (edge)",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          }
        },
        {
          "expr": "sum(rate(events_processed_total{service=\"validator\"}[1m]))",
          "legendFormat": "validated",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          }
        },
        {
          "expr": "sum(rate(events_processed_total{service=\"stream\"}[1m]))",
          "legendFormat": "processed (stream)",
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          }
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "title": "Consumer lag (messages)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (topic) (consumer_lag)",
          "legendFormat": "{{topic}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          }
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "title": "Event processing latency (ingest \u2192 processed)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(processing_latency_seconds_bucket[2m])))",
          "legendFormat": "p50",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          }
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(processing_latency_seconds_bucket[2m])))",
          "legendFormat": "p95",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          }
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(processing_latency_seconds_bucket[2m])))",
          "legendFormat": "p99",
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          }
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
